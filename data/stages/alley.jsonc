// 路地裏（エターナルリターンのルミア島の路地裏をイメージしたステージ）
// 書き方は open.jsonc の先頭を参照
//
// 建物の区画の間に、幅 250〜300 の路地が縦横に通っている。中央 (0, 0) は広場で、低い壁と箱がある。
// 一部の路地は壁でふさがれていて、行き止まりになっている。
{
  "id": "alley",
  "displayName": "路地裏",
  "description": "建物の間を路地が通る。行き止まりあり",
  "menuOrder": 2,
  "size": [5000, 3200],
  "obstacles": [
    // ---- 上の段の建物（ステージの上端まで） ----
    { "kind": "building", "rect": [-2500, -1600, 1000, 850] },
    { "kind": "building", "rect": [-1250, -1600, 800, 800] },
    { "kind": "building", "rect": [-150, -1600, 600, 750] },
    { "kind": "building", "rect": [700, -1600, 800, 850] },
    { "kind": "building", "rect": [1750, -1600, 750, 800] },

    // ---- 中の段の建物 ----
    { "kind": "building", "rect": [-2500, -500, 700, 950] },
    { "kind": "building", "rect": [-1550, -500, 650, 330] },
    { "kind": "building", "rect": [-1550, 120, 650, 330] },
    { "kind": "building", "rect": [600, -500, 600, 360] },
    { "kind": "building", "rect": [600, 110, 600, 340] },
    { "kind": "building", "rect": [1450, -500, 1050, 380] },
    { "kind": "building", "rect": [1450, 160, 1050, 290] },

    // ---- 下の段の建物（ステージの下端まで） ----
    { "kind": "building", "rect": [-2500, 750, 900, 850] },
    { "kind": "building", "rect": [-1350, 780, 850, 820] },
    { "kind": "building", "rect": [-200, 850, 700, 750] },
    { "kind": "building", "rect": [750, 750, 900, 850] },
    { "kind": "building", "rect": [1900, 750, 600, 850] },

    // ---- 壁 ----
    { "kind": "wall", "rect": [-350, -260, 260, 40] },   // 広場の低い壁（横）
    { "kind": "wall", "rect": [100, 200, 40, 220] },     // 広場の低い壁（縦）
    { "kind": "wall", "rect": [-1590, -170, 40, 290] },  // 左の建物の間の路地をふさぐ（行き止まり）
    { "kind": "wall", "rect": [1300, 450, 40, 300] },    // 下の横の路地を右寄りでふさぐ

    // ---- 箱 ----
    { "kind": "crate", "rect": [-520, 150, 100, 100] },
    { "kind": "crate", "rect": [380, -380, 110, 110] },
    { "kind": "crate", "rect": [-1700, 450, 100, 90] },
    { "kind": "crate", "rect": [1000, -750, 120, 80] }
  ],
  "bushes": [
    { "circle": [-750, 600, 130] }
  ]
}
