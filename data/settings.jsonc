// MOBA Trainer の設定ファイル
// ゲームの起動中に保存すると、自動で再読み込みされます（F5 キーでも再読み込みできます）
{
  // スキルの発動方式
  //   "quick" = キーを押した瞬間にカーソル方向へ発動
  //   （今後、範囲表示を出してキーを離した時に発動する方式などを追加予定）
  "castMode": "quick",

  // 起動時のカメラ（メニューと、プレイ中の Y キーでも切り替えられます）
  //   "locked" = 自キャラに固定（自キャラが常に画面の中央）
  //   "free"   = 固定しない（自キャラが動いてもカメラは動かず、画面の端にカーソルを置くとその方向へ動く）
  //   どちらでも、Space を押している間は自キャラを画面の中央に映します
  //   プレイ中は、カーソルがウィンドウの外に出ないようになります（メニュー・リザルト・別のウィンドウへの切り替えで解除）
  "cameraMode": "locked",

  // 画面の縦方向に映るゲーム内の距離。大きいほど引いた視点になる（2000 = 20m。ER と同じくらい）
  "cameraViewHeight": 2000,

  // カメラを固定しない時に、画面の端でカメラが動く速さ（ゲーム内の距離 / 秒）
  "cameraEdgeScrollSpeed": 2500,

  // カメラを固定しない時に、画面の端からこの幅まで近づくとカメラが動く
  // （ウィンドウの高さが 900 の時のピクセル。文字・ボタンと同じく、ウィンドウの高さに合わせて広くなります）
  "cameraEdgeMargin": 12,

  // 視界の半径（ゲーム内の距離。全キャラ共通）
  //   建物・壁・木と、自分が入っていないブッシュは視線を遮ります（箱は低いので遮りません）
  //   視界の外の敵キャラ・敵の弾・範囲・設置物は見えません
  "visionRadius": 1000,

  // 相手から見えていない時に、対象指定のスキル（エマの E など）で相手を撃つと、
  // 相手の陣営から見えるようになる時間（秒）。ブッシュの中から撃った時もこの時間
  "attackRevealTime": 3,

  // 視界の外を暗くする強さ（0 = 暗くしない、1 = 真っ黒）
  "fogDarkness": 0.6,

  // モードごとの、視界の初期値（メニューの「視界」でも選べます）
  //   true  = 全視界（敵も味方も、ステージのすべてが見える。視界の外の暗さも無い）
  //   false = 通常（上の visionRadius の視界）
  "fullVision": { "sandbox": true, "dodge": false, "shot": false },

  // クールダウン「標準」モードの倍率の初期値（モード開始前にメニューでも変更できます）
  //   1.0 = キャラ設定の値どおり（実戦と同じ）、0.5 = 2 分の 1、0.25 = 4 分の 1
  //   クールダウンを無くしたい場合は、メニューで「なし」を選んでください
  "cooldownScale": 0.25,

  // 弾・範囲の当たり判定の円を表示するか
  "showHitboxes": true,

  // 文字・ボタンの大きさの倍率
  //   ウィンドウの高さに合わせて自動で拡大・縮小した上で（高さ 900 の時が 1.0）、さらにこの倍率を掛けます
  //   解像度を変えても、画面に対する文字・ボタンの大きさの割合は変わりません（Windows の「拡大/縮小」は使いません）
  //   1.0 = 自動のまま、1.2 = それより 2 割大きく、0.8 = 2 割小さく
  "uiScale": 1.0,

  // ウィンドウの大きさ（解像度。実際のピクセル数で、Windows の拡大率は掛けません）
  //   メニューの「画面」で選ぶと、ここに保存されます（コメントはそのまま残ります）
  //   画面に入らない大きさの時は、入る中で最も大きい解像度（同じ縦横比を優先）で開きます
  //   ウィンドウの縁をドラッグして大きさを変えることはできません。Alt + Enter で全画面（モニターの解像度）に切り替え
  "window": { "width": 2400, "height": 1350 },

  // ログの出力レベル: "trace"（最も詳しい）/ "debug" / "info" / "warn" / "error"
  "logLevel": "debug"
}
