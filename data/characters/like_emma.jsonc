// like emma（ER のエマ風）
//
// 単位・共通項目の説明は like_ezreal.jsonc の先頭を参照。
// 数値は公式データが手に入らなかったため、動画から読み取った目安の値です。
//
// ■ このキャラで使う handler と params
//   "emma_q"             カードを投げて、自分の位置に鳩を残す。鳩がいれば（どれだけ離れていても）鳩もカードになって狙った地点へ飛ぶ
//                        speed, width, visual, color（エマのカード）,
//                        cooldownRefundOnHit（エマのカードが当たった時に、Q のクールダウンを本来の値の何割分短くするか）,
//                        doveLifetime（鳩が残る時間）, doveCardColor（鳩のカードの色）,
//                        doveCardSpeed, doveCardRange（鳩のカードの弾速・飛距離。省略するとエマ本体の speed / range と同じ）,
//                        doubleHitEffects（2 枚とも同じ敵に当たった時の効果）,
//                        doveCardDrawOffsetForward, doveCardDrawOffsetSide（溜めの間に R で鳩と入れ替わった時に、
//                        鳩のカードを見た目だけずらす量。省略すると 0）
//   "emma_w"             指定した地点が少し遅れて爆発し、その場に帽子が残る（R の対象）
//                        delay（爆発までの時間）, radius, hatLifetime, color, onHit,
//                        cooldownRefundOnHit（敵に当たった時に、W のクールダウンを本来の値の何割分短くするか）
//   "homing_projectile"  対象を追尾する弾（必ず当たる）。speed, width, visual, color, onHit
//   "emma_r"             鳩・帽子・兎（E で変身させた敵）を指定して、その位置へ瞬間移動する
//                        pickRadius（カーソルからこの距離以内の対象を選ぶ）, targetKinds,
//                        dovePathWidth, doveSpeed, doveOnHit（鳩: 位置を入れ替え、鳩がエマの元の位置へ飛ぶ。通り道の敵に効果）,
//                        hatFlightTime, hatRadius, hatOnHit（帽子: 位置を入れ替え、エマの元の位置で爆発。範囲の敵に効果）,
//                        rabbitRadius, rabbitOnHit（兎: 兎の周りの敵に効果）
//                        ※ 入れ替わった鳩・帽子は、残り時間が最初に戻って残り続ける
//   "ground_zone"        地点に投げて、一定時間残る範囲
//                        flightTime, radius, duration（残る時間）, visual, color,
//                        slowAmount / lingerTime（範囲内にいる間かかるスロウと、出た後も残る時間）, onHit
{
  "id": "like_emma",
  "displayName": "like emma",
  "origin": "ER",
  "menuOrder": 1,                 // メニューに並べる順（小さいほど上。新しいキャラは、今の最後の番号の次を付ける）
  "moveSpeed": 375,
  "hitboxRadius": 50,
  "color": [150, 225, 240],

  "skills": {
    "Q": {
      "name": "カード",
      "handler": "emma_q",
      "targeting": "direction",
      "castTime": 0.2,                // 動画から測った溜めの時間（キーを押してからカードが出るまで）
      // 溜めの間に R を使うと、溜めを続けたまま移動し、移動先からカードが出て鳩もそこに残る
      "usableDuringCast": ["R"],
      "cooldown": 4,
      "range": 950,
      "countsForHitRate": true,
      "usedByEnemy": true,
      "params": {
        "speed": 800,
        "width": 90,
        "visual": "card",
        "color": [190, 150, 255],
        "cooldownRefundOnHit": 0.3,
        "doveLifetime": 6,
        // 鳩のカードの弾速・飛距離。書かなければエマ本体のカード（speed / range）と同じになる。
        // 本体と別の値にしたい時だけ、コメントを外して書く
        // "doveCardSpeed": 1600,
        // "doveCardRange": 950,
        "doveCardColor": [245, 245, 255],
        // 溜めの間に R で鳩と入れ替わると、2 枚のカードが同じ位置から同じ方向へ飛んで重なるので、
        // 鳩のカードを見た目だけずらして描く（当たり判定はずらさない）。
        // Forward: 進む方向へのずれ（マイナスなら後ろ）、Side: 横方向のずれ（プラスなら進む方向の右）
        "doveCardDrawOffsetForward": -70,
        "doveCardDrawOffsetSide": 0,
        "doubleHitEffects": [ { "type": "slow", "amount": 0.4, "duration": 1.5 } ]
      }
    },

    "W": {
      "name": "帽子",
      "handler": "emma_w",
      "targeting": "point",
      "castTime": 0.15,
      "lockMovement": false,          // 硬直なし（溜めの間も移動できる）
      "cooldown": 10,
      "range": 700,
      "countsForHitRate": true,
      "usedByEnemy": true,
      "params": {
        "delay": 0.5,
        "radius": 170,
        "hatLifetime": 6,
        "color": [120, 200, 220],
        "cooldownRefundOnHit": 0.3,
        "onHit": []
      }
    },

    "E": {
      "name": "マジックビーム",
      "handler": "homing_projectile",
      "targeting": "unit",
      "castTime": 0.2,
      "cooldown": 12,
      "range": 475,
      "countsForHitRate": false,
      "params": {
        "speed": 1600,
        "width": 40,
        "visual": "beam",
        "color": [170, 200, 255],
        // 兎に変身させる（移動以外の行動ができず、移動速度 30% 低下）
        "onHit": [ { "type": "polymorph", "duration": 1.0, "amount": 0.3 } ]
      }
    },

    "R": {
      "name": "マジックショー",
      "handler": "emma_r",
      "targeting": "prop",
      "castTime": 0,                  // 動画では溜めが無く、すぐに移動する
      "cooldown": 20,
      "range": 800,
      "countsForHitRate": false,
      "params": {
        "pickRadius": 150,
        "targetKinds": ["dove", "hat", "rabbit"],
        "color": [200, 170, 255],
        "dovePathWidth": 120,
        "doveSpeed": 3000,
        "doveOnHit": [ { "type": "snare", "duration": 1.5 } ],
        "hatFlightTime": 0.15,
        "hatRadius": 250,
        "hatOnHit": [ { "type": "knockup", "duration": 1.0 } ],
        "rabbitRadius": 250,
        "rabbitOnHit": [ { "type": "polymorph", "duration": 0.9, "amount": 0.3 } ]
      }
    },

    "D": {
      "name": "鉄菱",
      "handler": "ground_zone",
      "targeting": "point",
      "castTime": 0.1,
      "cooldown": 15,
      "range": 600,
      "countsForHitRate": true,
      "params": {
        "flightTime": 0.35,
        "radius": 220,
        "duration": 4.5,
        "visual": "caltrops",
        "color": [170, 220, 255],
        "slowAmount": 0.5,
        "lingerTime": 0.5
      }
    },

    "F": null
  }
}
