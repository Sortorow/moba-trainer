// like ezreal（LoL のエズリアル風）
//
// ■ 単位
//   距離・幅・半径 = ゲーム内単位（LoL と同じ。100 ≒ ER の 1m）
//   時間 = 秒、速度 = 単位/秒、割合 = 0.0〜1.0（0.4 = 40%）
//   ゲームの起動中にこのファイルを保存すると、自動で再読み込みされます。
//
// ■ スキル共通の項目
//   name             表示名
//   handler          処理の種類（下記）
//   targeting        "direction"（方向指定） / "point"（地点指定） / "unit"（対象指定） / "prop"（設置物を指定） / "none"
//   castTime         詠唱時間。この間は移動できない
//   cooldown         クールダウン
//   range            射程
//   countsForHitRate スキルヒット率の集計に含めるか
//   movementSkill    移動系のスキルか（「移動系だけ使える」ルールを有効にした時に使う。今のモードでは使っていない）
//   usedByEnemy      スキルドッジでこのキャラが敵として出た時に、このスキルを使うか
//   aiPriority       敵 AI がスキルを選ぶ時の重み（省略時 1.0。大きいほど選ばれやすい）
//   params           処理ごとの個別の数値
//
// ■ handler の種類と params
//   "projectile"  直線に飛ぶ弾
//                 speed（弾速）, width（弾の幅）, pierce（true = 貫通）, visual（見た目）, color,
//                 onHit（当たった時の効果）, detonateMark（当たった敵のこの印を起爆する）
//   "blink"       カーソル方向へ瞬間移動（カーソルが射程内ならその位置、外なら射程の端）
//   "ezreal_e"    瞬間移動した後、近くの敵へ追尾弾を撃つ
//
// ■ visual（弾の見た目）: "orb"（球） / "ring"（輪） / "crescent"（半月） / "card"（カード） / "beam" / "bolt"
// ■ onHit（効果）の書き方: [ { "type": 種類, "duration": 秒, "amount": 割合, "tag": 印の名前 } ]
//   type: "slow"（スロウ） / "snare"（拘束） / "stun"（スタン） / "knockup"（打ち上げ） / "polymorph"（変身） / "mark"（印）
{
  "id": "like_ezreal",
  "displayName": "like ezreal",
  "origin": "LoL",
  "moveSpeed": 325,
  "hitboxRadius": 65,
  "color": [70, 170, 255],

  "skills": {
    "Q": {
      "name": "Mystic Shot",
      "handler": "projectile",
      "targeting": "direction",
      "castTime": 0.25,
      "cooldown": 4.5,
      "range": 1200,
      "countsForHitRate": true,
      "usedByEnemy": true,
      "params": {
        "speed": 2000,
        "width": 120,
        "pierce": false,
        "visual": "orb",
        "color": [120, 220, 255],
        // W の印が付いた敵に当たると、印を消費して起爆する
        "detonateMark": "ezreal_w"
      }
    },

    "W": {
      "name": "Essence Flux",
      "handler": "projectile",
      "targeting": "direction",
      "castTime": 0.25,
      "cooldown": 8,
      "range": 1200,
      "countsForHitRate": true,
      "usedByEnemy": true,
      "params": {
        "speed": 1700,
        "width": 160,
        "pierce": false,
        "visual": "ring",
        "color": [255, 210, 80],
        "onHit": [ { "type": "mark", "tag": "ezreal_w", "duration": 4 } ]
      }
    },

    "E": {
      "name": "Arcane Shift",
      "handler": "ezreal_e",
      "targeting": "direction",
      "castTime": 0.25,
      "cooldown": 20,
      "range": 475,
      "countsForHitRate": false,
      "movementSkill": true,
      "params": {
        "boltEnabled": true,         // 瞬間移動の後に追尾弾を撃つか（動画で確認できた動き）
        "boltSearchRange": 750,      // 追尾弾の対象を探す距離（移動先から）
        "boltSpeed": 2000,
        "boltWidth": 60,
        "boltPreferMark": "ezreal_w",  // この印が付いた敵を優先して狙う
        "boltDetonateMark": "ezreal_w", // 追尾弾が当たった時に起爆する印（空にすると起爆しない）
        "color": [255, 220, 120]
      }
    },

    "R": {
      "name": "Trueshot Barrage",
      "handler": "projectile",
      "targeting": "direction",
      "castTime": 1.0,
      "cooldown": 120,
      "range": 20000,
      "countsForHitRate": true,
      "usedByEnemy": true,
      "aiPriority": 0.6,              // 敵として使う時は、Q / W より選ばれにくくする
      "params": {
        "speed": 2000,
        "width": 320,
        "pierce": true,
        "visual": "crescent",
        "color": [255, 190, 60]
      }
    },

    "D": {
      "name": "Flash",
      "handler": "blink",
      "targeting": "direction",
      "castTime": 0,
      "cooldown": 300,
      "range": 400,
      "countsForHitRate": false,
      "movementSkill": true,
      "params": {}
    },

    "F": null
  }
}
