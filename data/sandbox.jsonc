// 練習場のダミーの設定
// ゲームの起動中に保存すると、自動で再読み込みされます（練習場で遊んでいる途中なら、ダミーが置き直されます）
//
// ■ 書き方
//   ダミーの組み合わせを「プリセット」として presets に並べます。
//   メニューか、練習場の画面右下の「練習場のダミー」で選ぶと、下の "preset" が自動で書き換わります。
//
//   プリセットの項目
//     name         名前（メニューに出る。プリセット同士で重複しないこと）
//     description  説明（省略可）
//     radius       このプリセットのダミーの当たり判定の半径（省略すると 65。自キャラの hitboxRadius と同じ単位）
//     moveSpeed    このプリセットのダミーの移動速度（省略すると 300）
//     color        このプリセットのダミーの色 [R, G, B]（省略すると赤）
//     dummies      ダミーの一覧。0 体でもよい
//
//   ダミーの項目
//     name       名前（省略すると「ダミー1」など）
//     position   置く位置 [x, y]（自キャラは (0, 0) から始まる。x は右、y は下がプラス）
//     patrolTo   書くと、position とこの位置の間を往復する。書かなければその場に静止する
//     radius / moveSpeed / color   このダミーだけ変えたい時に書く（省略するとプリセットの値）
//
//   ステージの広さは x が -2500〜2500、y が -1600〜1600 です。外に出る位置は、ステージの端に寄せます。
{
  // 今選んでいるプリセットの名前
  "preset": "小さい的",

  "presets": [
    {
      "name": "標準",
      "description": "静止 2 体と、上下に往復する 1 体",
      "radius": 65,
      "moveSpeed": 300,
      "dummies": [
        { "name": "ダミーA（静止）", "position": [650, -200] },
        { "name": "ダミーB（往復）", "position": [1000, -550], "patrolTo": [1000, 450] },
        { "name": "ダミーC（静止）", "position": [1450, 250] }
      ]
    },
    {
      "name": "小さい的",
      "description": "標準と同じ配置で、当たり判定を小さくする",
      "radius": 40,
      "moveSpeed": 300,
      "dummies": [
        { "name": "ダミーA（静止）", "position": [650, -200] },
        { "name": "ダミーB（往復）", "position": [1000, -550], "patrolTo": [1000, 450] },
        { "name": "ダミーC（静止）", "position": [1450, 250] }
      ]
    },
    {
      "name": "大きい的",
      "description": "標準と同じ配置で、当たり判定を大きくする",
      "radius": 100,
      "moveSpeed": 300,
      "dummies": [
        { "name": "ダミーA（静止）", "position": [650, -200] },
        { "name": "ダミーB（往復）", "position": [1000, -550], "patrolTo": [1000, 450] },
        { "name": "ダミーC（静止）", "position": [1450, 250] }
      ]
    },
    {
      "name": "動く的",
      "description": "向きと速さの違う 3 体が往復する（偏差撃ちの練習）",
      "radius": 65,
      "dummies": [
        { "name": "ダミーA（縦・遅い）", "position": [700, -500], "patrolTo": [700, 500], "moveSpeed": 250 },
        { "name": "ダミーB（横・普通）", "position": [800, -700], "patrolTo": [1500, -700], "moveSpeed": 340 },
        { "name": "ダミーC（斜め・速い）", "position": [1100, 100], "patrolTo": [1600, 700], "moveSpeed": 420 }
      ]
    },
    {
      "name": "距離の練習",
      "description": "右へ 300 ずつ離れて並ぶ 5 体（射程の確認）",
      "radius": 65,
      "dummies": [
        { "name": "300", "position": [300, 0] },
        { "name": "600", "position": [600, 0] },
        { "name": "900", "position": [900, 0] },
        { "name": "1200", "position": [1200, 0] },
        { "name": "1500", "position": [1500, 0] }
      ]
    }
  ]
}
