// MOBA Trainer の設定ファイル
// ゲームの起動中に保存すると、自動で再読み込みされます（F5 キーでも再読み込みできます）
{
  // スキルの発動方式
  //   "quick" = キーを押した瞬間にカーソル方向へ発動
  //   （今後、範囲表示を出してキーを離した時に発動する方式などを追加予定）
  "castMode": "quick",

  // カメラ
  //   "locked" = 自キャラに固定（今後、画面端スクロールを追加予定）
  "cameraMode": "locked",

  // 画面の縦方向に映るゲーム内の距離。大きいほど引いた視点になる
  "cameraViewHeight": 1500,

  // クールダウン「標準」モードの倍率の初期値（モード開始前にメニューでも変更できます）
  //   1.0 = キャラ設定の値どおり（実戦と同じ）、0.5 = 2 分の 1、0.25 = 4 分の 1
  //   クールダウンを無くしたい場合は、メニューで「なし」を選んでください
  "cooldownScale": 0.25,

  // 弾・範囲の当たり判定の円を表示するか
  "showHitboxes": true,

  // 文字・ボタンの大きさの倍率
  //   Windows の「拡大/縮小」（例: 150%）に合わせて自動で大きくした上で、さらにこの倍率を掛けます
  //   1.0 = Windows の設定どおり、1.2 = それより 2 割大きく、0.8 = 2 割小さく
  "uiScale": 1.0,

  // 起動時のウィンドウの大きさ（Windows の拡大率が 100% の時の大きさ。150% なら 1.5 倍になります）
  // 画面に収まらない場合は、画面の 85% に収まるように縮めます。Alt + Enter で全画面に切り替え
  "window": { "width": 1600, "height": 900 },

  // ログの出力レベル: "trace"（最も詳しい）/ "debug" / "info" / "warn" / "error"
  "logLevel": "debug"
}
