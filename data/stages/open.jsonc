// 障害物なしのステージ
//
// ■ ステージのファイルの書き方（路地裏・森のファイルも同じ）
//   ゲームの起動中に保存すると再読み込みされ、次に始めたプレイから反映されます（遊んでいる途中のステージは変わりません）。
//
//   id           ステージの ID（ファイル同士で重複しないこと）
//   displayName  メニューに出る名前
//   description  メニューで名前の横に出る説明（省略可）
//   menuOrder    メニューに並べる順（小さいほど上。一覧の最初のステージがメニューの初期値）
//   size         ステージの広さ [幅, 高さ]。中心が (0, 0) で、自キャラは (0, 0) から始まる
//                （x は右、y は下がプラス。例: [5000, 3200] なら x は -2500〜2500、y は -1600〜1600）
//   obstacles    通れない場所の一覧。弾は止めない（通り抜ける）
//                  { "kind": 種類, "rect": [左, 上, 幅, 高さ] }   長方形
//                  { "kind": 種類, "circle": [x, y, 半径] }        円
//                  kind: "building"（建物） / "wall"（壁） / "tree"（木） / "crate"（箱）。見た目だけが違う
//   bushes       ブッシュ（草むら）の一覧。形の書き方は obstacles と同じ（kind は不要）
//                重なっているブッシュは 1 つのブッシュとして扱う
//                ブッシュの中のキャラは外から見えない。同じブッシュの中にいれば見える。
//                ブッシュの中で対象指定のスキルを使うと、settings.jsonc の bushRevealTime 秒だけ外から見える
//
//   キャラの半径は 50〜65 くらいです。通路は幅 220 以上あけると、どのキャラも通れます。
//   自キャラが始まる (0, 0) の周りは、障害物を置かずに空けておいてください。
{
  "id": "open",
  "displayName": "障害物なし",
  "description": "何もない広場",
  "menuOrder": 1,
  "size": [5000, 3200],
  "obstacles": [],
  "bushes": []
}
