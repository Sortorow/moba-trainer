// 敵 AI の設定（スキルドッジの敵と、スキルショットの的）
// ゲームの起動中に保存すると、自動で再読み込みされます（次に開始したプレイから反映）
{
  // ===== スキルドッジの敵 =====

  // 敵のスキルのクールダウン倍率（キャラ設定の値 × この倍率）
  "enemyCooldownScale": 0.5,

  // 開始してから、敵が最初にスキルを撃つまでの時間（秒）
  "firstCastDelay": 1.5,

  // 敵が自キャラと取ろうとする距離の上限。画面の外から撃たれすぎないように抑える
  "maxEngageRange": 1000,

  // AI が想定する「プレイヤーが弾を見てから避け始めるまでの時間」（秒）
  "playerReactionTime": 0.25,

  // 賢さ 1〜5 の設定（上から順に 1, 2, 3, 4, 5）
  //   reactionTime      自キャラの動きを認識するまでの遅れ（秒）。小さいほど、今の動きに合わせて撃ってくる
  //   castInterval      スキルを撃つ間隔 [最小, 最大]（秒）。この範囲でランダム
  //   aimError          狙いのぶれ（ゲーム内単位）
  //   predict           狙う時に想定する、着弾時の自キャラの位置の重み
  //                       stay = その場に留まる / continue = 今の移動を続ける（偏差撃ち）/ dodge = 弾を見て横に避ける（避けた先を狙う）
  //   adaptive          自キャラが左右どちらに避けやすいかを学習して、避けた先を読む
  //   minHitChance      命中見込みがこれ未満の時は、撃つのを少し待つ（0〜1）
  //   strafe            横移動の多さ（0〜1）
  //   flank             他の敵と離れて、囲むように動く
  //   punishCC          自キャラが動けない時（拘束・スタン・打ち上げ）は、間隔を待たずにすぐ撃つ
  //   engageRangeRatio  自キャラとの距離を「スキルの射程 × この値」に保とうとする
  "levels": [
    {
      "name": "やさしい",
      "reactionTime": 0.40,
      "castInterval": [2.6, 3.4],
      "aimError": 120,
      "predict": { "stay": 1.0, "continue": 0.0, "dodge": 0.0 },
      "adaptive": false,
      "minHitChance": 0.0,
      "strafe": 0.0,
      "flank": false,
      "punishCC": false,
      "engageRangeRatio": 0.85
    },
    {
      "name": "ややかんたん",
      "reactionTime": 0.30,
      "castInterval": [2.0, 2.8],
      "aimError": 80,
      "predict": { "stay": 0.5, "continue": 0.5, "dodge": 0.0 },
      "adaptive": false,
      "minHitChance": 0.1,
      "strafe": 0.2,
      "flank": false,
      "punishCC": false,
      "engageRangeRatio": 0.8
    },
    {
      "name": "ふつう",
      "reactionTime": 0.20,
      "castInterval": [1.6, 2.3],
      "aimError": 50,
      "predict": { "stay": 0.25, "continue": 0.75, "dodge": 0.0 },
      "adaptive": false,
      "minHitChance": 0.2,
      "strafe": 0.4,
      "flank": true,
      "punishCC": true,
      "engageRangeRatio": 0.8
    },
    {
      "name": "むずかしい",
      "reactionTime": 0.12,
      "castInterval": [1.3, 1.9],
      "aimError": 30,
      "predict": { "stay": 0.2, "continue": 0.5, "dodge": 0.3 },
      "adaptive": false,
      "minHitChance": 0.3,
      "strafe": 0.6,
      "flank": true,
      "punishCC": true,
      "engageRangeRatio": 0.75
    },
    {
      "name": "とてもむずかしい",
      "reactionTime": 0.05,
      "castInterval": [1.0, 1.5],
      "aimError": 15,
      "predict": { "stay": 0.2, "continue": 0.4, "dodge": 0.4 },
      "adaptive": true,
      "minHitChance": 0.35,
      "strafe": 0.8,
      "flank": true,
      "punishCC": true,
      "engageRangeRatio": 0.75
    }
  ],

  // ===== スキルショットの的 =====
  // 的は 1 体で、スキルを撃たない。いくつかの動き方のパターンを組み合わせて動き回り、賢さに応じて自キャラのスキルを避ける
  "skillShot": {
    // 的の大きさの選択肢（メニューで選ぶ）。練習場のダミーのプリセット（小さい的 / 標準 / 大きい的）と同じ段階
    "sizes": [
      { "name": "小さい", "radius": 40 },
      { "name": "標準", "radius": 65 },
      { "name": "大きい", "radius": 100 }
    ],

    // 的の移動速度の選択肢（メニューで選ぶ）
    "moveSpeeds": [340, 375, 385, 400],

    // 自キャラとの距離。maxDistance（1100 = 11m）より離れず、minDistance より近づかない
    "minDistance": 300,
    "maxDistance": 1100,

    // 避ける時に、弾の幅・範囲の端から、さらにこの距離だけ離れる
    "dodgeMargin": 25,

    // 賢さ 1〜5 の設定（上から順に 1, 2, 3, 4, 5）。「避け方」と「動き方のパターンの混ぜ方」の 2 つの軸がある
    //
    // ■ 避け方
    //   reactionTime  自キャラの弾・範囲・詠唱に気づいて動き始めるまでの遅れ（秒）。
    //                 人が見てから反応できる速さの限界と言われる 0.15 秒より小さい値を書いても、0.15 秒として扱う
    //   dodgeChance   気づいた弾・範囲を避けようとする確率（0〜1）。0 なら避けない
    //   readCast      true なら、自キャラの詠唱（構え）を見て、弾・範囲が出る前に避け始める
    //   sideRandom    直線の弾を避ける時に、近い側ではなく遠い側へ避ける確率（0〜1）
    //
    // ■ 動き方のパターン（1 つのパターンが終わるたびに、patterns の重みで次のパターンを選ぶ）
    //   patterns      strafe   = 往復。自キャラから見て左右に、同じ幅で切り返す
    //                 approach = 接近。自キャラへまっすぐ近づき、撃たれそうになったら（射程に入った・自キャラが
    //                            止まった・構えた）、反応の遅れの後に急に左右へ切り返す
    //                 wander   = ランダムな位置へ動く
    //                 stop     = 立ち止まる
    //   strafeSwings  1 回の往復で切り返す回数 [最小, 最大]。同じ値なら毎回同じ回数（リズムを読まれやすい）
    //   strafeWidth   往復の幅 [最小, 最大]（100 = 1m）。1 回の往復の間は同じ幅で動き、往復ごとにこの範囲から選ぶ
    //   rhythmBreak   往復のリズムを崩す確率（0〜1）。2 回切り返した後から、切り返すたびに判定し、
    //                 崩す時は「いつもより大きく（2.5 倍）動く」か「少し（4 分の 1）だけ動いてすぐ切り返す」
    //   stopTime      立ち止まる時間 [最小, 最大]（秒）
    "levels": [
      {
        "name": "やさしい",
        "reactionTime": 0.50,
        "dodgeChance": 0.0,
        "readCast": false,
        "sideRandom": 0.0,
        "patterns": { "strafe": 0.7, "approach": 0.0, "wander": 0.0, "stop": 0.3 },
        "strafeSwings": [4, 4],
        "strafeWidth": [200, 200],
        "rhythmBreak": 0.0,
        "stopTime": [1.0, 1.5]
      },
      {
        "name": "ややかんたん",
        "reactionTime": 0.40,
        "dodgeChance": 0.3,
        "readCast": false,
        "sideRandom": 0.1,
        "patterns": { "strafe": 0.6, "approach": 0.0, "wander": 0.2, "stop": 0.2 },
        "strafeSwings": [3, 5],
        "strafeWidth": [180, 250],
        "rhythmBreak": 0.05,
        "stopTime": [0.8, 1.3]
      },
      {
        "name": "ふつう",
        "reactionTime": 0.30,
        "dodgeChance": 0.55,
        "readCast": false,
        "sideRandom": 0.25,
        "patterns": { "strafe": 0.45, "approach": 0.2, "wander": 0.2, "stop": 0.15 },
        "strafeSwings": [2, 5],
        "strafeWidth": [150, 300],
        "rhythmBreak": 0.15,
        "stopTime": [0.5, 1.1]
      },
      {
        "name": "むずかしい",
        "reactionTime": 0.22,
        "dodgeChance": 0.75,
        "readCast": true,
        "sideRandom": 0.35,
        "patterns": { "strafe": 0.4, "approach": 0.3, "wander": 0.15, "stop": 0.15 },
        "strafeSwings": [1, 5],
        "strafeWidth": [120, 350],
        "rhythmBreak": 0.3,
        "stopTime": [0.3, 0.9]
      },
      {
        "name": "とてもむずかしい",
        "reactionTime": 0.18,
        "dodgeChance": 0.9,
        "readCast": true,
        "sideRandom": 0.5,
        "patterns": { "strafe": 0.4, "approach": 0.35, "wander": 0.1, "stop": 0.15 },
        "strafeSwings": [1, 6],
        "strafeWidth": [100, 400],
        "rhythmBreak": 0.45,
        "stopTime": [0.2, 0.8]
      }
    ]
  }
}
